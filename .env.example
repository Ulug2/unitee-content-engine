# Copy this file to .env and fill in real values. .env is gitignored.

# https://my.telegram.org -> API development tools. Only needed to re-scrape source channels
# (export_channels.py, inspect_channels.py, test_telegram.py), not to run generate_posts.py.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The two source Telegram channels to scrape (t.me/... URLs). Kept out of the committed code so
# the source community isn't identifiable from the repo. Only needed for the scrape/inspect
# scripts above.
CHANNEL_A_URL=
CHANNEL_B_URL=

# https://platform.openai.com/api-keys. Needed by generate_posts.py.
OPENAI_API_KEY=
